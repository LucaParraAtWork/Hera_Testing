# Copy this file to ".env" (in the same folder) and fill in real values.
# ".env" is already gitignored at the repo root -- never commit real
# credentials.

# SQL Server login for heraplantdatabasedev, same one you use in SSMS
# (e.g. "heraadmin").
HERA_DB_USER=
HERA_DB_PASSWORD=

# Only needed if you're pointing at a different server/database than the
# defaults baked into check_dispatched_profiles.py.
# HERA_DB_SERVER=heradatabasedev.database.windows.net
# HERA_DB_NAME=heraplantdatabasedev
